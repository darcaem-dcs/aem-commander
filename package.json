{
  "name": "aem-commander",
  "version": "0.2.1",
  "description": "Autonomous Engagement Monitor: DCS companion app that emulates the HQ issuing orders to armed forces.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package-win": "electron-packager . aem-json-monitor --overwrite --asar=true --platform=win32 --arch=x64 --icon=./icon.ico --prune=true --out=release-builds --version-string.CompanyName=CE --version-string.FileDescription=AEMJsonMonitor --version-string.ProductName=\"AEM JSON Monitor\"",
    "package-mac": "electron-packager . aem-json-monitor --overwrite --asar=true --platform=darwin --arch=x64 --icon=./icon.icns --prune=true --out=release-builds --version-string.CompanyName=CE --version-string.FileDescription=AEMJsonMonitor --version-string.ProductName=\"AEM JSON Monitor\"",
    "package-linux": "electron-packager . aem-json-monitor --overwrite --asar=true --platform=linux --arch=x64 --icon=./icon.png --prune=true --out=release-builds --version-string.CompanyName=CE --version-string.FileDescription=AEMJsonMonitor --version-string.ProductName=\"AEM JSON Monitor\"",
	"build-mac-windows": "electron-builder --mac --x64"
  },
  "build": {
    "appId": "com.darcaem.aem-commander",
    "productName": "AEM Commander",
    "mac": {
      "target": "zip",
      "icon": "icon.png"
    }
  },
  "keywords": [],
  "author": "Alfonso Escriche Martínez",
  "license": "MIT",
  "devDependencies": {
    "electron": "^29.1.0",
	"electron-builder": "^24.13.3",
    "electron-packager": "^17.1.2"
  },
  "dependencies": {
    "@google/genai": "^1.51.0"
  },
  "overrides": {
    "@noble/hashes": "1.3.2"
  }
}
